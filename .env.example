# Copy this file to `.env` and fill in real values.
# The real `.env` is git-ignored and must NEVER be committed.

# Signs login tokens. Generate one with:
#   openssl rand -hex 32
# The server refuses to start in production without it.
JWT_SECRET=

# Postgres connection string. When set, all storage uses Postgres and content
# survives restarts. When absent, the app falls back to a local JSON file,
# which is fine for development but loses data on every restart.
# Free options: Neon, Supabase, or a Render database.
# DATABASE_URL=postgres://user:password@host:5432/database

# Optional: pin CORS to a single origin, e.g. https://redhan.mv
# ALLOWED_ORIGIN=

# Optional: port (defaults to 3000)
# PORT=3000
